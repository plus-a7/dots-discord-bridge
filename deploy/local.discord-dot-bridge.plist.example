<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>local.discord-dot-bridge</string>
  <key>Disabled</key><true/>
  <key>RunAtLoad</key><false/>
  <key>KeepAlive</key><false/>
  <key>ProgramArguments</key>
  <array>
    <string>__ABSOLUTE_NODE_BINARY__</string>
    <string>__ABSOLUTE_PROJECT_DIRECTORY__/dist/src/main.js</string>
    <string>run</string><string>--config</string>
    <string>__ABSOLUTE_PRIVATE_DIRECTORY__/deployment.json</string>
    <string>--activate</string>
  </array>
  <key>WorkingDirectory</key><string>__ABSOLUTE_PROJECT_DIRECTORY__</string>
  <key>StandardOutPath</key><string>__ABSOLUTE_PRIVATE_DIRECTORY__/bridge.stdout.log</string>
  <key>StandardErrorPath</key><string>__ABSOLUTE_PRIVATE_DIRECTORY__/bridge.stderr.log</string>
  <key>Umask</key><integer>63</integer>
  <key>ExitTimeOut</key><integer>40</integer>
  <key>ThrottleInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
